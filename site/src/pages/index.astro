---
import BookShell from "../layouts/BookShell.astro";
import { loadCurriculum } from "../lib/curriculum";

const curriculum = await loadCurriculum();
---

<BookShell
  {curriculum}
  title="Learn kongctl"
  description="A short, hands-on guide to managing Kong Konnect with kongctl."
>
  <div class="page home-page">
    <section class="hero">
      <p class="eyebrow">A hands-on field guide</p>
      <h1>Learn kongctl by using it.</h1>
      <p class="hero-copy">
        Short lessons. Real commands. Just enough context to understand what
        kongctl is doing before you move on.
      </p>
      <div class="hero-actions">
        <a
          class="button primary"
          href={curriculum.lessons[0]?.url}
          data-start-link
        >
          Start learning <span aria-hidden="true">→</span>
        </a>
        <a
          class="button secondary"
          href="https://developer.konghq.com/kongctl/"
        >
          Read the full docs <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>

    <section class="chapter-grid" aria-labelledby="chapters-heading">
      <div class="section-heading">
        <p class="eyebrow">Guide contents</p>
        <h2 id="chapters-heading">Two chapters to get moving</h2>
      </div>
      {
        curriculum.chapters.map((chapter, index) => (
          <a class="chapter-card" href={chapter.url}>
            <div class="chapter-card-top">
              <span class="chapter-number">
                {String(index + 1).padStart(2, "0")}
              </span>
              <span class="card-arrow" aria-hidden="true">
                ↗
              </span>
            </div>
            <h3>{chapter.title}</h3>
            <p>{chapter.description}</p>
            <span class="lesson-total">
              {chapter.lessons.length}{" "}
              {chapter.lessons.length === 1 ? "lesson" : "lessons"}
            </span>
          </a>
        ))
      }
    </section>
  </div>
</BookShell>
